imedia.org/wikipedia/commons/thumb/f/f3/Open_book_01.svg/60px-Open_book_01.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"360\" data-file-height=\"360\" /></a></span><i><a href=\"/wiki/aggettivo\" title=\"aggettivo\">Aggettivo</a></i></h3></div> \n<p><b>sgomento</b><small>&#160;(<span typeof=\"mw:File\"><a href=\"/wiki/File:Wikiquote-logo.svg\" class=\"mw-file-description\" title=\"Wikiquote\"><img alt=\"Wikiquote\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Wikiquote-logo.svg/20px-Wikiquote-logo.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"24\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Wikiquote-logo.svg/40px-Wikiquote-logo.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"300\" data-file-height=\"355\" /></a></span> <b><a href=\"https://it.wikiquote.org/wiki/sgomento\" class=\"extiw\" title=\"q:sgomento\">citazioni</a></b>)</small> \n</p>\n<table style=\"float:right; margin-left:0.5em; margin-bottom:0.5em;border: 1px solid #AAAAAA; border-collapse:collapse;\" cellpadding=\"3\" rules=\"all\">\n\n<tbody><tr align=\"center\">\n<th>&#160;\n</th>\n<th bgcolor=\"#FFFFE0\">&#160;<i><a href=\"/wiki/singolare\" title=\"singolare\">singolare</a></i>&#160;\n</th>\n<th bgcolor=\"#FFFFE0\">&#160;<i><a href=\"/wiki/plurale\" title=\"plurale\">plurale</a></i>&#160;\n</th></tr>\n<tr align=\"center\">\n<th bgcolor=\"#FFFFE0\">&#160;<i><a href=\"/wiki/maschile\" title=\"maschile\">maschile</a></i>&#160;\n</th>\n<td>&#160; <a class=\"mw-selflink selflink\">sgomento</a>&#160;\n</td>\n<td>&#160; <a href=\"/wiki/sgomenti\" title=\"sgomenti\">sgomenti</a>&#160;\n</td></tr>\n<tr align=\"center\">\n<th bgcolor=\"#FFFFE0\">&#160;<i><a href=\"/wiki/femminile\" title=\"femminile\">femminile</a></i>&#160;\n</th>\n<td>&#160; <a href=\"/wiki/sgomenta\" title=\"sgomenta\">sgomenta</a>&#160;\n</td>\n<td>&#160; <a href=\"/wiki/sgomente\" title=\"sgomente\">sgomente</a>&#160;\n</td></tr></tbody></table>\n<ol><li>che esprime o denota <a href=\"/wiki/smarrimento\" title=\"smarrimento\">smarrimento</a>\n<ul><li><i> aveva una volto <b>sgomento</b><small></small></i></li></ul></li></ol>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Sostantivo\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Open_book_01.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Open_book_01.svg/40px-Open_book_01.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Open_book_01.svg/60px-Open_book_01.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"360\" data-file-height=\"360\" /></a></span><i><a href=\"/wiki/sostantivo\" title=\"sostantivo\">Sostantivo</a></i></h3></div> \n<p><b>sgomento</b><small></small> <i> m sing</i> (<i>pl.</i>: <a href=\"/wiki/sgomenti\" title=\"sgomenti\">sgomenti</a>)\n</p>\n<ol><li>forte <a href=\"/w/index.php?title=agitazine&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"agitazine (la pagina non esiste)\">agitazine</a> per una <a href=\"/wiki/circostanza\" title=\"circostanza\">circostanza</a>, un <a href=\"/wiki/avvenimento\" title=\"avvenimento\">avvenimento</a> inatteso, inconsueto o <a href=\"/wiki/increscioso\" title=\"increscioso\">increscioso</a></li></ol>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Voce_verbale\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Open_book_01.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Open_book_01.svg/40px-Open_book_01.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Open_book_01.svg/60px-Open_book_01.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"360\" data-file-height=\"360\" /></a></span><i><a href=\"/wiki/voce_verbale\" title=\"voce verbale\">Voce verbale</a></i></h3></div> \n<p><b>sgomento</b><small></small>\n</p>\n<ol><li>prima persona singolare dell'indicativo presente di <a href=\"/wiki/sgomentare\" title=\"sgomentare\">sgomentare</a></li></ol>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Sillabazione\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Hyph_abc.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Hyph_abc.svg/60px-Hyph_abc.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"45\" height=\"23\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Hyph_abc.svg/120px-Hyph_abc.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"512\" data-file-height=\"260\" /></a></span> <a href=\"/wiki/sillabazione\" title=\"sillabazione\">Sillabazione</a></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Template:-sill-&amp;action=edit&amp;section=T-1\" title=\"Modifica la sezione Sillabazione\"><span>modifica</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<dl><dt>sgo | mén | to</dt></dl>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Pronuncia\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Nuvola_apps_edu_languages.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Nuvola_apps_edu_languages.svg/40px-Nuvola_apps_edu_languages.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Nuvola_apps_edu_languages.svg/60px-Nuvola_apps_edu_languages.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></span> <a href=\"/wiki/pronuncia\" title=\"pronuncia\">Pronuncia</a></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Template:-pron-&amp;action=edit&amp;section=T-1\" title=\"Modifica la sezione Pronuncia\"><span>modifica</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p><a href=\"/wiki/Aiuto:IPA\" title=\"Aiuto:IPA\">AFI</a>: <span class=\"IPA\" style=\"font-family:&#39;Segoe UI&#39;, &#39;Calibri&#39;, &#39;DejaVu Sans&#39;, &#39;Charis SIL&#39;, &#39;Doulos SIL&#39;, &#39;Gentium Plus&#39;, Gentium, GentiumAlt, &#39;Lucida Grande&#39;, &#39;Arial Unicode MS&#39;, sans-serif; font-size: 110%;\">/zɡoˈmento/</span>\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Etimologia_/_Derivazione\"><span id=\"Etimologia_.2F_Derivazione\"></span><span typeof=\"mw:File\"><a href=\"/wiki/File:Nuvola_kdict_glass.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/18/Nuvola_kdict_glass.svg/40px-Nuvola_kdict_glass.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/18/Nuvola_kdict_glass.svg/60px-Nuvola_kdict_glass.svg.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></span><a href=\"/wiki/etimologia\" title=\"etimologia\">Etimologia</a> / <a href=\"/wiki/derivazione\" title=\"derivazione\">Derivazione</a></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Template:-etim-&amp;action=edit&amp;section=T-1\" title=\"Modifica la sezione Etimologia / Derivazione\"><span>modifica</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>derivazione di <a href=\"/wiki/sgomentare\" title=\"sgomentare\">sgomentare</a>,  forse dal <a href=\"/wiki/latino\" title=\"latino\">latino</a> <i><a href=\"/w/index.php?title=excommentare&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"excommentare (la pagina non esiste)\">excommentare</a></i> cioè \"<a href=\"/wiki/turbare\" title=\"turbare\">turbare</a>\", formato da <a href=\"/wiki/ex-\" title=\"ex-\">ex-</a> e <i><a href=\"/w/index.php?title=commentari&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"commentari (la pagina non esiste)\">commentari</a></i> ossia \"<a href=\"/wiki/pensare\" title=\"pensare\">pensare</a>, <a href=\"/wiki/ragionare\" title=\"ragionare\">ragionare</a> <a href=\"/wiki/riflettere\" title=\"riflettere\">riflettere</a>\"\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Sinonimi\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Icona_sinonimi.png\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Icona_sinonimi.png/40px-Icona_sinonimi.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/5/59/Icona_sinonimi.png?utm_source=it.wiktionary.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x\" data-file-width=\"120\" data-file-height=\"120\" /></a></span> <a href=\"/wiki/sinonimi\" title=\"sinonimi\">Sinonimi</a></h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Template:-sin-&amp;action=edit&amp;section=T-1\" title=\"Modifica la sezione Sinonimi\"><span>modifica</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><b>(aggettivo)</b> <a href=\"/wiki/atterrito\" title=\"atterrito\">atterrito</a>, <a href=\"/wiki/disanimato\" title=\"disanimato\">disanimato</a>, <a href=\"/wiki/disorientato\" title=\"disorientato\">disorientato</a>, <a href=\"/wiki/impaurito\" title=\"impaurito\">impaurito</a>, <a href=\"/wiki/impressionato\" title=\"impressionato\">impressionato</a>, <a href=\"/wiki/intimorito\" title=\"intimorito\">intimorito</a>, <a href=\"/wiki/sbigottito\" title=\"sbigottito\">sbigottito</a>, <a href=\"/wiki/spaventato\" title=\"spaventato\">spaventato</a>, <a href=\"/wiki/turbato\" title=\"turbato\">turbato</a></li>\n<li><a href=\"/wiki/confuso\" title=\"confuso\">confuso</a>,  <a href=\"/wiki/scombussolato\" title=\"scombussolato\">scombussolato</a>, <a href=\"/wiki/sconcertato\" title=\"sconcertato\">sconcertato</a>, <a href=\"/wiki/sgomentato\" title=\"sgomentato\">sgomentato</a>, <a href=\"/wiki/terrorizzato\" title=\"terrorizzato\">terrorizzato</a>,</li>\n<li><b>(sostantivo)</b> <a href=\"/wiki/abbattimento\" title=\"abbattimento\">abbattimento</a>, <a href=\"/wiki/agitazione\" title=\"agitazione\">agitazione</a>, <a href=\"/wiki/ansia\" title=\"ansia\">ansia</a>, <a href=\"/wiki/apprensione\" title=\"apprensione\">apprensione</a>, <a href=\"/wiki/avvilimento\" title=\"avvilimento\">avvilimento</a>, <a href=\"/wiki/confusione\" title=\"confusione\">confusione</a>, <a href=\"/wiki/depressione\" title=\"depressione\">depressione</a>, <a href=\"/wiki/disorientamento\" title=\"disorientamento\">disorientamento</a>, <a href=\"/wiki/panico\" title=\"panico\">panico</a>, <a href=\"/wiki/paura\" title=\"paura\">paura</a>,  <a href=\"/wiki/sbigottimento\" title=\"sbigottimento\">sbigottimento</a>, <a href=\"/wiki/scombussolamento\" title=\"scombussolamento\">scombussolamento</a>,  <a href=\"/wiki/sconcerto\" title=\"sconcerto\">sconcerto</a>, <